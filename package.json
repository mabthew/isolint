{
  "name": "isolint",
  "version": "0.1.0",
  "description": "Scan repos for hardcoded values that break parallel worktree workflows",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "isolint": "dist/bin/isolint.js"
  },
  "files": [
    "dist/src/",
    "dist/bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "dev": "tsc --watch",
    "start": "node dist/bin/isolint.js",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test dist/test/*.test.js dist/test/rules/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "worktree",
    "parallel-development",
    "git",
    "audit",
    "parallel",
    "ci",
    "docker",
    "ports",
    "lint",
    "static-analysis"
  ],
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mabthew/isolint.git"
  },
  "homepage": "https://github.com/mabthew/isolint#readme",
  "bugs": {
    "url": "https://github.com/mabthew/isolint/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.6.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2"
  }
}
